  <string name="game_loader_error_load_game">Có gì đó tệ đã xảy ra khi đang tải trò chơi của bạn. Hãy đảm bảo rằng ROM này được Fulldroid hỗ trợ và quét lại các trò chơi của bạn.</string>
  <string name="game_loader_error_save">Có gì đó tệ đã xảy ra với tệp lưu của bạn. Nếu vấn đề này vẫn tiếp diễn, hãy thử tắt tự động lưu.</string>
  <string name="game_loader_error_unsupported_architecture">Thiết bị của bạn không hỗ trợ lõi này.</string>
  <string name="game_loader_error_generic">Có gì đó tệ đã xảy ra. Hãy thử những điều sau:\n
        \n\u2022 Tắt tự động lưu và chạy lại trò chơi
